{
  "manifest_version": 3,
  "name": "ImageTools Agent",
  "version": "1.0.0",
  "description": "Runs ImageTools jobs in this ChatGPT tab.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "host_permissions": ["http://127.0.0.1:8081/*", "https://chatgpt.com/*", "https://*.oaiusercontent.com/*"]
}
